{
  "name": "argocd-api-client",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript client for the Argo CD REST API",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm test",
    "docs": "typedoc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "argocd",
    "argo-cd",
    "gitops",
    "api-client",
    "rest",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "homepage": "https://github.com/ElJijuna/argocd-api-client",
  "bugs": {
    "url": "https://github.com/ElJijuna/argocd-api-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ElJijuna/argocd-api-client.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "semantic-release": "^25.0.3",
    "super-configs": "^1.5.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.0",
    "typescript": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}